# ========== GENERAL CONFIG ==========
NODE_ENV="development"
PUBLIC_SERVER_URL="http://localhost:5173"

# ========== DATABASE CONFIG ==========
DATABASE_URL="http://127.0.0.1:8080"
DATABASE_AUTH_TOKEN="your-database-auth-token"

# ========== BUCKET CONFIG ==========
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket"
R2_ENDPOINT="https://<your-bucket>.r2.cloudflarestorage.com"
R2_URL="https://pub-<your-bucket>.r2.dev"
R2_REGION=auto

# ========== AUTH CONFIG ==========
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="http://localhost:5173"

# ========== BOOKING CONFIG ==========
BOOKING_TAX_RATE=10
BOOKING_FEE_PERCENTAGE=5
BOOKING_PROCESSING_FEE_PERCENTAGE=5