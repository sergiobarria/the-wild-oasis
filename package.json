{
    "name": "the-wild-oasis",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "check": "prettier --check . && eslint",
        "test:e2e": "playwright test",
        "auth:generate": "better-auth generate --config ./convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts",
        "email:dev": "email dev --dir emails --port 3001",
        "seed:cabins": "bun run scripts/seed-cabins.ts",
        "seed:reviews": "bun run scripts/seed-reviews.ts",
        "seed:feature-flags": "bun run scripts/seed-feature-flags.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@convex-dev/better-auth": "^0.12.5",
        "@convex-dev/rate-limiter": "^0.3.2",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tanstack/react-form": "^1.33.4",
        "better-auth": "1.6.15",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "convex": "^1.43.0",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.30.0",
        "next": "16.3.0",
        "next-themes": "^0.4.6",
        "nextjs-toploader": "^3.9.17",
        "nuqs": "^2.9.5",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "react-email": "^6.9.2",
        "recharts": "3.8.0",
        "shadcn": "^4.16.2",
        "sonner": "^2.0.7",
        "stripe": "^22.4.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@better-auth/cli": "^1.4.21",
        "@edge-runtime/vm": "^5.0.0",
        "@playwright/test": "^1.62.1",
        "@react-email/ui": "^6.9.2",
        "@tailwindcss/postcss": "^4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "babel-plugin-react-compiler": "1.0.0",
        "convex-test": "^0.0.55",
        "eslint": "^9",
        "eslint-config-next": "16.3.0",
        "eslint-config-prettier": "^10.1.8",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.10"
    },
    "packageManager": "bun@1.3.14",
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
